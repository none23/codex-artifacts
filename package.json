{
  "name": "codex-artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted private publishing for agent-generated HTML artifacts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/none23/codex-artifacts.git"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "scripts": {
    "build": "lakebed build . --target anonymous",
    "check": "npm run test && npm run build",
    "dev": "lakebed dev",
    "deploy": "lakebed deploy",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.1",
    "hono": "4.13.3",
    "preact": "10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/workers-types": "5.20260818.1",
    "@preact/preset-vite": "2.10.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.124.0",
    "lakebed": "0.0.29"
  }
}
