{
  "name": "codex-artifacts",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted private publishing for agent-generated HTML artifacts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/none23/codex-artifacts.git"
  },
  "engines": {
    "node": ">=26.7"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev": "vite dev",
    "deploy": "npm run build && wrangler deploy --config dist/codex_artifacts/wrangler.json",
    "preview": "vite preview",
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-auth": "1.7.1",
    "hono": "4.13.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@cloudflare/workers-types": "5.20260818.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.131.0"
  }
}
